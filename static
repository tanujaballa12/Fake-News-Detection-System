/* ===========================
GLOBAL
=========================== */

body{
    font-family:'Poppins',sans-serif;

    background:
    linear-gradient(
        rgba(4,20,50,0.75),
        rgba(4,20,50,0.75)
    ),
    url("/static/images/login_bg.png");

    background-size:cover;
    background-position:center;
    background-attachment:fixed;
    background-repeat:no-repeat;

    color:#ffffff;;
    overflow-x:hidden;
}

/* ===========================
NAVBAR
=========================== */

.navbar{
    background:#092652 !important;
   min-height:70px;
    padding:12px 30px;
    box-shadow:0 3px 15px rgba(0,0,0,.15);
}

.navbar-brand{
    color:#eaeef5 !important;
    font-weight:700;
     font-size:26px;
}

.nav-link{
    color:#bfd3f5 !important;
    font-weight:500;
}

.nav-link:hover{
    color:#38558b !important;
}

/* ===========================
HERO
=========================== */

.hero{
    padding:100px 0;

    background:rgba(255,255,255,0.05);

    backdrop-filter:blur(5px);
}

.hero h1{
    color:#ffffff;
    font-size:60px;
    font-weight:700;
}

.hero p{
    font-size:22px;
    color:#dbeafe;
}

.hero-image{
    max-width:500px;
    width:100%;
}
.hero .row{
    min-height:75vh;
    align-items:center;
}

/* ===========================
BUTTONS
=========================== */
.btn-primary{
    background:#07214d !important;
    border:none !important;
    color:white !important;

    box-shadow:0 0 15px rgba(59,130,246,.5);
}

.btn-primary:hover{
    background:rgba(255,255,255,0.15) !important;
}

.btn-outline-primary{
    background:transparent !important;
    border:2px solid white !important;
    color:white !important;
}

.btn-outline-primary:hover{
    background:rgba(255,255,255,0.15) !important;
    color:white !important;
}

/* ===========================
STATS
=========================== */


.stats{
    background:transparent;
    padding:70px 0;
}
.stats h2{
    color:#ffffff;
}

.stats p{
    color:#dbeafe;
}

/* ===========================
ABOUT
=========================== */

#about{
    padding:80px 0;
    background:transparent;
    color:white !important;
}

#about h2,
#about h3,
#about h4,
#about h5,
#about p,
#about span,
#about li{
    color:white !important;
}
#about .text-muted{
    color:white !important;
}

/* ===========================
HOW IT WORKS
=========================== */

#work{
    padding:80px 0;
    background:transparent;
}

#work h2{
    color:#ffffff !important;
}

#work p{
    color:#dbeafe !important;
}

/* ===========================
DETECTOR
=========================== */

#detector{
    padding:80px 0;
    background:transparent;
}
#detector h2{
    color:#021535;
}

#news{
    border:2px solid #698cbb;
    border-radius:15px;
    padding:18px;
}

#news:focus{
    border-color:#052e75;
    box-shadow:0 0 12px rgba(82, 112, 165, 0.2);
    outline:none;
}

#count{
    color:#041b44;
    font-weight:600;
}
.admin-btn {
    background: #b8caf3;
    color: white;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    display: inline-block;
}

.admin-btn:hover {
    background: #081947;
}

/* ===========================
CARDS
=========================== */

.card{
    border:none;
    border-radius:20px;

    background:rgba(255,255,255,0.90);

    box-shadow:0 8px 25px rgba(11,61,145,.08);
}

.card:hover{
    transform:translateY(-8px);
    box-shadow:0 15px 35px rgba(11,61,145,.12);
}

/* ===========================
FEATURES
=========================== */
#features{
    background:transparent;
    padding:80px 0;
}

#features h2{
    color:#dfdede !important;
}

.feature-card{
    min-height:260px;
}

/* ===========================
LOADING
=========================== */

#loading{
    margin-top:30px;
}

/* ===========================
RESULT
=========================== */

#result{
    margin-top:30px;
}

.progress{
    border-radius:30px;
    height:24px;
}

/* ===========================
TABLES
=========================== */

.table th{
    background:#062861;
    color:rgb(223, 221, 221);
}

.table td{
    background:white;
}

/* ===========================
FOOTER
=========================== */

footer{
    background:#072e70;
    color:white;
    padding:30px 0;
}

/* ===========================
SCROLL BUTTON
=========================== */

#topBtn{
    position:fixed;
    bottom:25px;
    right:25px;
    display:none;
    width:50px;
    height:50px;
    border-radius:50%;
    z-index:999;
}

/* ===========================
DARK MODE
=========================== */

.dark-mode{
    background:#0f172a;
    color:#cbd5e1;
}

.dark-mode section{
    background:#1e293b !important;
}

.dark-mode h1,
.dark-mode h2,
.dark-mode h3,
.dark-mode h4,
.dark-mode h5,
.dark-mode h6{
    color:#d1d5db;
}

.dark-mode p,
.dark-mode span,
.dark-mode td,
.dark-mode li{
    color:#cbd5e1;
}

.dark-mode .navbar{
    background:#0f172a !important;
}

.dark-mode .navbar-brand,
.dark-mode .nav-link{
    color:#d1d5db !important;
}

.dark-mode .card{
    background:#334155;
    color:#cbd5e1;
}

.dark-mode textarea{
    background:#475569;
    color:#e5e7eb;
    border:1px solid #64748b;
}

.dark-mode table{
    background:#334155;
    color:#e5e7eb;
}

.dark-mode footer{
    background:#020617;
}

/* ===========================
ANIMATIONS
=========================== */

.card{

transition:all .3s ease;

}

.card:hover{

transform:translateY(-8px);

}


.hero-image{
    max-width:500px;
    width:100%;
}
.feature-card{
    min-height: 260px;
}

#features .col-lg-5{
    margin-right: 20px;
}
#about img{
    max-width:100%;
    border-radius:15px;
}
/* ===============================
LOGIN PAGE
=============================== */

.login-card{

    border-radius:25px;

    overflow:hidden;

    max-width:450px;

    width:100%;

    margin:auto;


    background:rgba(255,255,255,0.15);


    backdrop-filter:blur(15px);


    box-shadow:
    0 15px 40px rgba(0,0,0,0.35);

}
/* ===============================
LOGIN BACKGROUND IMAGE
=============================== */


.login-page{

    min-height:100vh;


    background:

    linear-gradient(
        rgba(3,18,45,0.75),
        rgba(3,18,45,0.75)
    ),

    url("/static/images/login_bg.png");


    background-size:cover;

    background-position:center;

    background-repeat:no-repeat;


    display:flex;

    justify-content:center;

    align-items:center;

}
.login-card h4{
    color:#04183a;
}

.login-card h5{
    font-weight:700;
}

.dark-mode .login-card{
    background:#334155;
}
.profile-circle{

   width:80px;
    height:80px;
    border-radius:50%;

    background:linear-gradient(
    135deg,
    #d8d9da,
    #dadadb
    );

    display:flex;
    align-items:center;
    justify-content:center;

    color:rgb(10, 10, 10);
    font-size:30px;


    background:linear-gradient(
    135deg,
    #061441,
    #60a5fa
    );

    display:flex;
    align-items:center;
    justify-content:center;

    color:white;
    font-size:40px;

}

.dashboard-card h3{
    color:#ecf1fa;
    font-weight:700;
 font-size:40px;
}

.username{

    color:#ecf1fa;
    font-weight:600;
font-size:22px;
}

.dashboard-info{

    margin-top:20px;

}

.info-box{

    background:#eef6ff;

    padding:15px;

    border-radius:15px;

    margin-bottom:12px;

    display:flex;
    align-items:center;
    gap:12px;

}

.info-box i{
    color:black !important;
}

.info-box span{
    font-weight:500;
    color:black !important;
}
/* DARK MODE */

.dark-mode .dashboard-card{

    background:#334155;
    color:#bfd3f5;

}

.dark-mode .dashboard-card h3,
.dark-mode .username{

   color:#bfd3f5;

}

.dark-mode .info-box{

    background:#475569;

}

.dark-mode .info-box i{

    color:#93c5fd;

}
.dashboard-card{
    background: transparent;
    max-width: 380px;
    margin-left: auto;

    position: relative;
    top: -60px;      /* move up */

    transform: translateX(20px); /* move right */
}
/* ===============================
PASSWORD SHOW / HIDE
=============================== */

.password-box{
    position:relative;
    width:100%;
}

.password-box input{
    width:100%;
    height:50px;
    padding-right:50px;
}

.password-box .eye-icon{
    position:absolute;
    right:15px;
    top:25px;
    transform:translateY(-50%);
    cursor:pointer;
    color:#555;
    font-size:18px;
    z-index:10;
}

.password-box .eye-icon:hover{
    color:#082b66;
}

